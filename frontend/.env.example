# Copy this file to .env and fill values before running the frontend.
#
# Windows PowerShell:
#   Copy-Item .env.example .env

# Chain identity
VITE_CHAIN_ID=localwasm
VITE_BECH32_PREFIX=wasm

# Tendermint RPC (CosmJS uses this)
VITE_RPC_ENDPOINT=http://localhost:26657

# REST is optional; kept for convenience
VITE_REST_ENDPOINT=http://localhost:1317

# Token / gas config
VITE_DENOM=stake
VITE_GAS_PRICE=0.025stake

# Deployed contract address (fill after instantiate)
VITE_CONTRACT_ADDRESS=

# UI
VITE_APP_NAME=BlockBoard Cosmos

# Logging
# - info (default): store events for Download Logs only
# - debug: also prints audit events to the browser console
VITE_LOG_LEVEL=info
